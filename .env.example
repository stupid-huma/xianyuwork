# Telegram Bot Token from BotFather.
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID.
TELEGRAM_ADMIN_USER_ID=

# App runtime environment: dev / prod.
APP_ENV=dev

# Log level: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# API credentials only. Provider/mode/model switches live in config/settings.py.
OPENAI_API_KEY=
QWEN_API_KEY=

# Base data paths.
DATA_DIR=data
INCOMING_DIR=data/incoming
ORDERS_DIR=data/orders
DATABASE_PATH=data/database/xianyu_photo_workflow.db

# Preview watermark settings.
WATERMARK_TEXT=PREVIEW
WATERMARK_OPACITY=90
PREVIEW_MAX_SIZE=1600

# Supported input image formats.
SUPPORTED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp

# Folder polling interval in seconds.
WATCH_INTERVAL_SECONDS=2
