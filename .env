# Telegram Bot Token
# 从 BotFather 获取，例如：123456789:ABCxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=""

# 你的 Telegram 用户 ID，用于限制只有你能审核/操作
# 可以通过 @userinfobot 获取
TELEGRAM_ADMIN_USER_ID=""

# 项目运行环境：dev / prod
APP_ENV=dev

# 是否启用 OpenAI API
# 你目前可以先保持 false，后续如果能用 API 再切换
ENABLE_OPENAI_API=false

# OpenAI API Key，可暂时留空
OPENAI_API_KEY=

# 基础数据目录
DATA_DIR=data

# 待处理图片输入目录
INCOMING_DIR=data/incoming

# 订单目录
ORDERS_DIR=data/orders

# SQLite 数据库文件路径
DATABASE_PATH=data/database/xianyu_photo_workflow.db

# 水印文字
WATERMARK_TEXT=PREVIEW

# 水印透明度：0-255，越大越明显
WATERMARK_OPACITY=90

# 预览图最长边尺寸
PREVIEW_MAX_SIZE=1600

# 支持的图片格式，用英文逗号分隔
SUPPORTED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp

# 文件夹监听轮询间隔，单位秒
WATCH_INTERVAL_SECONDS=2

# 日志等级：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# IMAGE_PROCESSOR_MODE=local：当前先用本地占位流程
# 以后如果真接 API，就改成：
# IMAGE_PROCESSOR_MODE=with_api
IMAGE_PROCESSOR_MODE=local
DEFAULT_IMAGE_PROMPT=在保持原始构图、人物特征和色彩关系的基础上，提升清晰度、修复模糊、优化细节质感，输出自然真实的高清效果图。